# COPY TO .env AND CHANGE ALL PASSWORDS BEFORE docker compose up
COMPOSE_PROJECT_NAME=military-rag-pilot
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
VIEWER_USER=reader
VIEWER_PASSWORD=CHANGE_ME_READER_PASSWORD
APP_PORT=8080
# Ollama on the Windows desktop host (Docker Desktop + Ollama installed on Windows)
OLLAMA_URL=http://host.docker.internal:11434
EMBED_MODEL=bge-m3
CHAT_MODEL=gemma3:4b
EMBED_DIMS=1024
MAX_UPLOAD_MB=40
ORG_LABEL=Demo Οργανισμός
